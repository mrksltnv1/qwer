<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background.

  A real DRAWABLE, not a @color reference: getDrawable() on a colour resource throws
  NotFoundException and breaks the install-time icon preview (this caused a silent
  install failure earlier in the project).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#151A33"
        android:endColor="#0A0C12" />
</shape>
